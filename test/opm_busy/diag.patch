+/*
+ * 書き込みが化けていないことの検証。
+ *
+ * OPM のレジスタは読み戻せないが、タイマ A の周期は書き込んだ CLKA の値
+ * そのもの（64 x (1024 - CLKA) / φM）なので、周期を測れば「チップが実際に
+ * 何を受け取ったか」が分かる。ウェイトを詰めて書き込みが化けれれば周期がずれる。
+ *
+ * 戻り値は測った中での最大の誤差 (us)。読み出しの往復ぶん数 us は必ず出るので、
+ * 「化けていない」の判定は CLKA 1 LSB ぶん（φM=4MHz で 16us）より十分小さいこと。
+ */
+uint32_t opm_diag_verify(uint32_t n, uint32_t *worst_clka, uint32_t *measured_us,
+                         uint32_t *expected_us)
+{
+    uint32_t worst = 0;
+    *worst_clka = 0;
+    *measured_us = 0;
+    *expected_us = 0;
+
+    for (uint32_t i = 0; i < n; i++)
+    {
+        /* 周期が 256us〜2048us に収まる範囲を舐める。
+         * これより短いと読み出しの往復（約 2us）に埋もれて測れない。
+         * CLKA が 1 だけ化けても周期は 16us（φM=4MHz）動くので判別できる。 */
+        uint32_t clka = 896u + (i * 71u) % 112u;
+
+        opm_write(0x10u, (uint8_t)(clka >> 2));
+        opm_write(0x11u, (uint8_t)(clka & 0x03u));
+        opm_write(0x14u, 0x10u); /* F-Reset A、LOAD A を落とす */
+        opm_write(0x14u, 0x05u); /* LOAD A + IRQEN A で走らせる（README §3.21 と同じ） */
+
+        uint32_t t0 = time_us_32();
+        uint32_t elapsed;
+        for (;;)
+        {
+            if ((opm_read(true) & 0x01u) != 0u)
+            {
+                elapsed = time_us_32() - t0;
+                break;
+            }
+            if (time_us_32() - t0 > 10000u)
+            {
+                elapsed = 0; /* 立たなかった */
+                break;
+            }
+        }
+
+        uint32_t expect =
+            (uint32_t)((64ull * (1024ull - clka) * 1000000ull) / opm_clock_hz_actual());
+        uint32_t err = (elapsed > expect) ? (elapsed - expect) : (expect - elapsed);
+        if (err > worst)
+        {
+            worst = err;
+            *worst_clka = clka;
+            *measured_us = elapsed;
+            *expected_us = expect;
+        }
+    }
+
+    opm_write(0x14u, 0x00u);
+    return worst;
+}
+
+uint32_t opm_diag_sys_hz(void)
+{
+    return clock_get_hz(clk_sys);
+}
+#endif /* OPM_DIAG */
