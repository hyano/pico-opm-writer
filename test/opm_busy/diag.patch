+#if OPM_DIAG
+/* ---- BUSY 調査用（test/opm_busy/）。調査後に削除する ------------------- */
+
+/*
+ * 1 点の測定。opm_write() ではなくバス操作を直接並べるので、OPM_BUSY_POLL /
+ * OPM_BUSY_DEFER をどう焼いても測り方は同じになる。ポーリングで測ると
+ * ポーリング自身のバス操作が測定対象を乱すので、遅延を振って 1 回だけ読む。
+ */
+/*
+ * 掃引用のステータス読み。opm_read() をそのまま使うと t_RD の busy_wait_us_32(1)
+ * がタイマ境界へ丸めるので、サンプル時刻が 1us 単位に量子化されて分解能が
+ * 落ちる。ここではサイクル基準の待ちに置き換えて、サンプル時刻が delay の
+ * 連続関数になるようにしてある（バスの動かし方は opm_read() と同一）。
+ */
+static bool opm_diag_status_busy(void)
+{
+    uint32_t rd_cycles = (uint32_t)(((uint64_t)clock_get_hz(clk_sys) * OPM_T_RD_US + 999999u) / 1000000u);
+
+    opm_bus_set_dir(false);
+    gpio_put_masked(OPM_MASK_A0 | OPM_MASK_CS, OPM_MASK_A0);
+    busy_wait_at_least_cycles(s_setup_cycles);
+    gpio_clr_mask(OPM_MASK_RD);
+    busy_wait_at_least_cycles(rd_cycles);
+    uint32_t all = gpio_get_all();
+    gpio_set_mask(OPM_MASK_RD);
+    gpio_set_mask(OPM_MASK_CS);
+    busy_wait_us_32(OPM_T_FLOAT_US);
+    opm_bus_set_dir(true);
+
+    return ((all >> (OPM_PIN_D0 + 7)) & 1u) != 0u;
+}
+
+bool opm_diag_busy_at(uint8_t addr, uint8_t data, uint32_t delay_cycles)
+{
+    opm_busy_flush();
+    busy_wait_us_32(100); /* 直前の書き込みの BUSY を確実に明けさせる */
+
+    opm_bus_cycle(false, addr);
+    busy_wait_us_32(OPM_T_ADDR_US);
+    opm_bus_cycle(true, data);
+    busy_wait_at_least_cycles(delay_cycles);
+
+    return opm_diag_status_busy();
+}
+
+bool opm_diag_busy_at_addr(uint8_t addr, uint32_t delay_cycles)
+{
+    opm_busy_flush();
+    busy_wait_us_32(100);
+
+    opm_bus_cycle(false, addr);
+    busy_wait_at_least_cycles(delay_cycles);
+
+    return opm_diag_status_busy();
+}
+
+uint32_t opm_diag_read_ns(uint32_t n)
+{
+    opm_busy_flush();
+    busy_wait_us_32(100);
+    uint32_t t0 = time_us_32();
+    for (uint32_t i = 0; i < n; i++)
+    {
+        (void)opm_read(true);
+    }
+    uint32_t dt = time_us_32() - t0;
+    return (uint32_t)(((uint64_t)dt * 1000u) / n);
+}
+
+uint32_t opm_diag_poll_ns(uint32_t n)
+{
+    opm_busy_flush();
+    busy_wait_us_32(100);
+    uint32_t t0 = time_us_32();
+    opm_read_enter();
+    for (uint32_t i = 0; i < n; i++)
+    {
+        (void)opm_read_once(true);
+    }
+    opm_read_leave();
+    uint32_t dt = time_us_32() - t0;
+    return (uint32_t)(((uint64_t)dt * 1000u) / n);
+}
+
+/* TL を最小音量にする書き込み（opm_clear() が使う値）なので音は出ない */
+uint32_t opm_diag_write_ns(uint32_t n, uint32_t work_us)
+{
+    opm_busy_flush();
+    busy_wait_us_32(100);
+    uint32_t t0 = time_us_32();
+    for (uint32_t i = 0; i < n; i++)
+    {
+        opm_write(0x60u, 0x7fu);
+        if (work_us != 0u)
+        {
+            busy_wait_us_32(work_us);
+        }
+    }
+    opm_busy_flush(); /* 繰り延べた待ちも勘定に入れる */
+    uint32_t dt = time_us_32() - t0;
+    return (uint32_t)(((uint64_t)dt * 1000u) / n);
+}
+
+/* work_us だけを回したときの 1 回あたり。opm_diag_write_ns() から引く用。 */
+uint32_t opm_diag_spin_ns(uint32_t n, uint32_t work_us)
+{
+    uint32_t t0 = time_us_32();
+    for (uint32_t i = 0; i < n; i++)
+    {
+        if (work_us != 0u)
+        {
+            busy_wait_us_32(work_us);
+        }
+    }
+    uint32_t dt = time_us_32() - t0;
+    return (uint32_t)(((uint64_t)dt * 1000u) / n);
+}
+
