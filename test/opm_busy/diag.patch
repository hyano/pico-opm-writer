+#if OPM_DIAG
+/* ---- BUSY 調査用（test/opm_busy/）。調査後に削除する ------------------- */
+
+#define DIAG_STEP_NS 125u
+
+static uint32_t diag_cycles_for_ns(uint32_t ns)
+{
+    return (uint32_t)(((uint64_t)ns * opm_diag_sys_hz()) / 1000000000u);
+}
+
+/*
+ * delay を 0 から max_ns まで振り、各点で reps 回測って BUSY=1 だった回数を出す。
+ * last_all1_ns / first_all0_ns に境界を返す（見つからなければ UINT32_MAX）。
+ */
+static uint32_t s_diag_rise_ns; /* BUSY が立つまでの期待値 */
+static uint32_t s_diag_fall_ns; /* BUSY が落ちるまでの期待値 */
+
+static void diag_sweep(uint8_t addr, uint8_t data, bool addr_only, uint32_t max_ns,
+                       uint32_t reps, bool verbose, uint32_t *last_all1_ns,
+                       uint32_t *first_all0_ns)
+{
+    *last_all1_ns = UINT32_MAX;
+    *first_all0_ns = UINT32_MAX;
+    uint64_t area1 = 0;    /* sum P(BUSY)  = E[fall] - E[rise] */
+    uint64_t lead0 = 0;    /* 立ち上がる前の sum (1-P) = E[rise] */
+    bool risen = false;
+
+    for (uint32_t ns = 0; ns <= max_ns; ns += DIAG_STEP_NS)
+    {
+        uint32_t cycles = diag_cycles_for_ns(ns);
+        uint32_t busy = 0;
+        for (uint32_t i = 0; i < reps; i++)
+        {
+            bool b = addr_only ? opm_diag_busy_at_addr(addr, cycles)
+                               : opm_diag_busy_at(addr, data, cycles);
+            if (b)
+            {
+                busy++;
+            }
+        }
+        if (busy == reps && *first_all0_ns == UINT32_MAX)
+        {
+            *last_all1_ns = ns;
+        }
+        if (busy == 0u && *first_all0_ns == UINT32_MAX && ns != 0u)
+        {
+            *first_all0_ns = ns;
+        }
+        area1 += busy;
+        tud_task(); /* 長い掃引の間も USB を回す（回さないとホストが切断する） */
+        if (busy == reps)
+        {
+            risen = true;
+        }
+        if (!risen)
+        {
+            lead0 += (reps - busy);
+        }
+        if (verbose)
+        {
+            printf("%u\t%u\t%u\n", (unsigned)ns, (unsigned)busy, (unsigned)reps);
+        }
+    }
+    s_diag_rise_ns = (uint32_t)((lead0 * DIAG_STEP_NS) / reps);
+    s_diag_fall_ns = s_diag_rise_ns + (uint32_t)((area1 * DIAG_STEP_NS) / reps);
+}
+
+static void diag_report_bounds(const char *label, uint32_t last1, uint32_t first0)
+{
+    printf("# %-10s: last BUSY=1 %u ns / first BUSY=0 %u ns\n", label,
+           (unsigned)last1, (unsigned)(first0 == UINT32_MAX ? 0u : first0));
+}
+
+static void cmd_busy(char **cursor)
+{
+    char *sub = next_token(cursor);
+    if (sub == NULL)
+    {
+        reply_err("wrong arity");
+        return;
+    }
+
+    if (tok_is(sub, "sweep") || tok_is(sub, "addr"))
+    {
+        bool addr_only = tok_is(sub, "addr");
+        char *ta = next_token(cursor);
+        uint8_t a = 0x60u, d = 0x7fu;
+        if (ta != NULL)
+        {
+            const char *err = parse_hex_u8(ta, &a);
+            if (err != NULL) { reply_err(err); return; }
+        }
+        if (!addr_only)
+        {
+            char *td = next_token(cursor);
+            if (td != NULL)
+            {
+                const char *err = parse_hex_u8(td, &d);
+                if (err != NULL) { reply_err(err); return; }
+            }
+        }
+
+        uint32_t max_ns = 30000u;
+        char *tm = next_token(cursor);
+        if (tm != NULL)
+        {
+            uint32_t v;
+            const char *err = parse_dec_u32(tm, 200000u, &v);
+            if (err != NULL) { reply_err(err); return; }
+            max_ns = v;
+        }
+
+        uint32_t last1, first0;
+        printf("# sweep   : addr=0x%02x data=0x%02x %s sys=%u Hz phim=%u Hz\n",
+               a, d, addr_only ? "(address cycle only)" : "", (unsigned)opm_diag_sys_hz(),
+               (unsigned)opm_clock_hz_actual());
+        puts("# delay_ns\tbusy\treps");
+        diag_sweep(a, d, addr_only, max_ns, 32u, true, &last1, &first0);
+        diag_report_bounds("bounds", last1, first0);
+        printf("# expect  : rise %u ns  fall %u ns  width %u ns\n",
+               (unsigned)s_diag_rise_ns, (unsigned)s_diag_fall_ns,
+               (unsigned)(s_diag_fall_ns - s_diag_rise_ns));
+        opm_clear();
+        reply_ok();
+        return;
+    }
+
+    if (tok_is(sub, "regs"))
+    {
+        static const uint8_t regs[] = {0x01u, 0x08u, 0x0fu, 0x12u, 0x14u, 0x18u,
+                                       0x1bu, 0x20u, 0x28u, 0x38u, 0x60u, 0xe0u};
+        static const uint8_t vals[] = {0x00u, 0x08u, 0x00u, 0xffu, 0x00u, 0x00u,
+                                       0x00u, 0x00u, 0x4au, 0x00u, 0x7fu, 0x0fu};
+        printf("# regs    : sys=%u Hz phim=%u Hz\n", (unsigned)opm_diag_sys_hz(),
+               (unsigned)opm_clock_hz_actual());
+        puts("# addr\tdata\tlast1_ns\tfirst0_ns\trise_ns\tfall_ns");
+        for (uint32_t i = 0; i < count_of(regs); i++)
+        {
+            uint32_t last1, first0;
+            diag_sweep(regs[i], vals[i], false, 30000u, 32u, false, &last1, &first0);
+            printf("0x%02x\t0x%02x\t%u\t%u\t%u\t%u\n", regs[i], vals[i], (unsigned)last1,
+                   (unsigned)(first0 == UINT32_MAX ? 0u : first0),
+                   (unsigned)s_diag_rise_ns, (unsigned)s_diag_fall_ns);
+        }
+        opm_clear();
+        reply_ok();
+        return;
+    }
+
+    if (tok_is(sub, "phim"))
+    {
+        char *th = next_token(cursor);
+        if (th == NULL) { reply_err("wrong arity"); return; }
+        uint32_t hz;
+        const char *err = parse_dec_u32(th, 8000000u, &hz);
+        if (err != NULL) { reply_err(err); return; }
+        if (hz < 100000u) { reply_err("out of range"); return; }
+        opm_clock_retune_for(opm_diag_sys_hz(), hz);
+        busy_wait_us_32(1000);
+        printf("# phim    : %u Hz (clkdiv %u + %u/256)\n", (unsigned)opm_clock_hz_actual(),
+               (unsigned)opm_clock_div_int(), (unsigned)opm_clock_div_frac());
+        reply_ok();
+        return;
+    }
+
+    if (tok_is(sub, "scale"))
+    {
+        /*
+         * φM を振って境界を測る。sys_clk は動かさないので読み出し経路のオフセットは
+         * 一定のまま、境界 b(φM) = N/φM - offset が 1/φM の 1 次式になる。
+         * 傾きから BUSY の φM サイクル数 N が、切片からオフセットが出る。
+         */
+        /* φM 周期が 1us（タイマの刻み）と整合すると位相が固定されて偏るので、
+         * 144MHz の整数分周のうち周期が割り切れないものを選ぶ。 */
+        static const uint32_t phim[] = {3600000u, 3000000u, 2400000u, 1800000u,
+                                        1440000u, 1200000u};
+        uint32_t sys_hz = opm_diag_sys_hz();
+        printf("# scale   : addr=0x60 data=0x7f sys=%u Hz\n", (unsigned)sys_hz);
+        puts("# phim_hz\tlast1_ns\tfirst0_ns\trise_ns\tfall_ns");
+        for (uint32_t i = 0; i < count_of(phim); i++)
+        {
+            uint32_t last1, first0;
+            opm_clock_retune_for(sys_hz, phim[i]);
+            busy_wait_us_32(1000);
+            /* 100 φM サイクルぶんまで見れば足りる */
+            uint32_t max_ns = (uint32_t)((100ull * 1000000000ull) / phim[i]);
+            diag_sweep(0x60u, 0x7fu, false, max_ns, 64u, false, &last1, &first0);
+            printf("%u\t%u\t%u\t%u\t%u\n", (unsigned)opm_clock_hz_actual(),
+                   (unsigned)last1, (unsigned)(first0 == UINT32_MAX ? 0u : first0),
+                   (unsigned)s_diag_rise_ns, (unsigned)s_diag_fall_ns);
+        }
+        opm_clock_retune_for(sys_hz, OPM_CLOCK_HZ);
+        busy_wait_us_32(1000);
+        opm_clear();
+        printf("# restored: phim=%u Hz\n", (unsigned)opm_clock_hz_actual());
+        reply_ok();
+        return;
+    }
+
+    if (tok_is(sub, "read"))
+    {
+        printf("# read    : opm_read() %u ns  opm_read_once() %u ns\n",
+               (unsigned)opm_diag_read_ns(2000u), (unsigned)opm_diag_poll_ns(2000u));
+        reply_ok();
+        return;
+    }
+
+    if (tok_is(sub, "bench"))
+    {
+        static const uint32_t work[] = {0u, 2u, 5u, 10u, 15u, 20u, 30u, 50u};
+        printf("# bench   : poll=%d defer=%d sys=%u Hz phim=%u Hz\n", OPM_BUSY_POLL,
+               OPM_BUSY_DEFER, (unsigned)opm_diag_sys_hz(),
+               (unsigned)opm_clock_hz_actual());
+        puts("# work_us\titer_ns\tspin_ns\twrite_ns");
+        for (uint32_t i = 0; i < count_of(work); i++)
+        {
+            uint32_t iter = opm_diag_write_ns(2000u, work[i]);
+            uint32_t spin = opm_diag_spin_ns(2000u, work[i]);
+            printf("%u\t%u\t%u\t%u\n", (unsigned)work[i], (unsigned)iter, (unsigned)spin,
+                   (unsigned)(iter > spin ? iter - spin : 0u));
+        }
+        opm_clear();
+        reply_ok();
+        return;
+    }
+
+    if (tok_is(sub, "verify"))
+    {
+        uint32_t n = 512u;
+        char *tn = next_token(cursor);
+        if (tn != NULL)
+        {
+            uint32_t v;
+            const char *err = parse_dec_u32(tn, 100000u, &v);
+            if (err != NULL) { reply_err(err); return; }
+            n = v;
+        }
+        uint32_t clka = 0, meas = 0, exp = 0;
+        /* 1 回だけ単発で測って表示（動いていることの確認用） */
+        uint32_t c1 = 0, m1 = 0, e1 = 0;
+        (void)opm_diag_verify(1u, &c1, &m1, &e1);
+        printf("# sample  : clka=%u measured=%u us expected=%u us\n", (unsigned)c1,
+               (unsigned)m1, (unsigned)e1);
+        uint32_t worst = opm_diag_verify(n, &clka, &meas, &exp);
+        printf("# verify  : poll=%d defer=%d t_data=%dus n=%u\n", OPM_BUSY_POLL,
+               OPM_BUSY_DEFER, OPM_T_DATA_US, (unsigned)n);
+        printf("# worst   : clka=%u measured=%u us expected=%u us err=%u us\n",
+               (unsigned)clka, (unsigned)meas, (unsigned)exp, (unsigned)worst);
+        opm_clear();
+        reply_ok();
+        return;
+    }
+
+    if (tok_is(sub, "stat"))
+    {
+        printf("# busy    : poll=%d defer=%d timeouts=%u polls_max=%u\n", OPM_BUSY_POLL,
+               OPM_BUSY_DEFER, (unsigned)opm_diag_busy_timeouts(),
+               (unsigned)opm_diag_busy_polls_max());
+        reply_ok();
+        return;
+    }
+
+    reply_err("unknown command");
+}
