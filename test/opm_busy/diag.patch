+/* ---- BUSY 待ち（test/opm_busy/ の調査用。既定はどちらも 0 = 従来動作） ---- */
+
+static void opm_read_enter(void);
+static uint8_t opm_read_once(bool a0);
+static void opm_read_leave(void);
+
+#if OPM_BUSY_POLL
+/*
+ * BUSY が立つ前に読むと即座に抜けて書き込みが化けるので、データサイクルから
+ * 最低これだけは空けてから最初のポーリングを行う。time_us_32() の分解能が 1us
+ * なので実際には 1〜2us になる。
+ */
+#define OPM_BUSY_ASSERT_US  2u
+/* チップ不在なら A0=1 の読みは直前に駆動した値を返す。bit7 が立っていると
+ * 永久に BUSY に見えるので、必ず打ち切って固定ウェイトへ落ちる。 */
+#define OPM_BUSY_TIMEOUT_US (2u * OPM_T_DATA_US)
+
+static uint32_t s_busy_timeouts;  /* 打ち切った回数 */
+static uint32_t s_busy_polls_max; /* 1 回の待ちで読んだ最大回数 */
+
+static void opm_busy_settle(uint32_t ref_us)
+{
+    while ((int32_t)(time_us_32() - (ref_us + OPM_BUSY_ASSERT_US)) < 0)
+    {
+        tight_loop_contents();
+    }
+
+    opm_read_enter();
+    uint32_t polls = 0;
+    bool timed_out = false;
+    while ((opm_read_once(true) & 0x80u) != 0u)
+    {
+        polls++;
+        if (time_us_32() - ref_us >= OPM_BUSY_TIMEOUT_US)
+        {
+            timed_out = true;
+            break;
+        }
+    }
+    opm_read_leave();
+
+    if (timed_out)
+    {
+        busy_wait_us_32(OPM_T_DATA_US);
+        s_busy_timeouts++;
+    }
+    if (polls > s_busy_polls_max)
+    {
+        s_busy_polls_max = polls;
+    }
+}
+#endif /* OPM_BUSY_POLL */
+
+#if OPM_BUSY_DEFER
+static uint32_t s_busy_ref_us; /* データサイクルを終えた時刻 */
+static bool s_busy_pending;
+
+/*
+ * 未消化の待ちを消化する。バスを触る前と、φM を止める / 張り替える前に必ず呼ぶ
+ * （φM が止まると BUSY が明けないまま書き込みが化ける）。
+ */
+void opm_busy_flush(void)
+{
+    if (!s_busy_pending)
+    {
+        return;
+    }
+    s_busy_pending = false;
+#if OPM_BUSY_POLL
+    opm_busy_settle(s_busy_ref_us);
+#else
+    /* time_us_32() は 71.6 分でラップするので符号付きの差分で比較する */
+    while ((int32_t)(time_us_32() - (s_busy_ref_us + OPM_T_DATA_US)) < 0)
+    {
+        tight_loop_contents();
+    }
+#endif
+}
+#else
+void opm_busy_flush(void)
+{
+}
+#endif /* OPM_BUSY_DEFER */
